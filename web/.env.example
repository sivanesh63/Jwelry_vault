# Copy to .env.local for local development, and set the same two values in
# Cloudflare Pages → Settings → Environment variables (Production AND Preview).
#
# Both are safe in the browser. The anon key grants nothing on its own — Row
# Level Security decides what it can reach, which is why supabase/tests must
# pass before real data goes in.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public half of the VAPID pair, used to subscribe a device to push.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# NEVER put the service_role key or the VAPID private key in this file.
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript bundle and is
# readable by anyone who opens the page. Those two belong in Worker secrets:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put VAPID_PRIVATE_KEY
